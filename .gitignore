/compilation/release/
/compilation/build/
/compilation/dist/
/compilation/build_launcher.bat.maj
/compilation/sauvegarde_locale/
/compilation/icon.ico
*.spec

# --- Unity : dossiers recrees a chaque ouverture ---
/compilation/unity/Library/
/compilation/unity/Temp/
/compilation/unity/Logs/
/compilation/unity/obj/
/compilation/unity/UserSettings/
/compilation/unity/Builds/
/compilation/personnage/Library/
/compilation/personnage/Temp/
/compilation/personnage/Logs/
/compilation/personnage/obj/
/compilation/personnage/UserSettings/
/compilation/personnage/Builds/

# --- Executable du createur produit par build_launcher.bat ---
/jeu/personnage/LibreViesPersonnage.exe
/jeu/personnage/UnityPlayer.dll
/jeu/personnage/UnityCrashHandler64.exe
/jeu/personnage/LibreViesPersonnage_Data/
/jeu/personnage/MonoBleedingEdge/

# --- Python ---
__pycache__/
*.pyc

# Configuration MySQL locale du serveur (jamais versionnee)
/jeu/serveur/config.php

