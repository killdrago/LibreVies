def check_for_updates(progress_cb):
    local_cfg = load_local_config()
    raw_url = normalize_raw_url(local_cfg.get('raw_url', '') or DEFAULT_RAW_URL)
    if not raw_url:
        return {"error": "Pas d'URL configuree", "modified": [], "remote_cfg": None,
                "build": None}
    try:
        progress_cb(5, 'Connexion au serveur de mises a jour...')
        remote_cfg = _lire_json(get_remote_url('version_url.json', raw_url))
    except Exception as e:
        return {"error": "Pas de connexion (%s)" % e, "modified": [],
                "remote_cfg": None, "build": None}

    modified = []
    for fname, info in _manifest_files(remote_cfg).items():
        try:
            local_path = _safe_local_path(fname)
        except ValueError:
            continue
        is_text = fname.lower().endswith(TEXT_EXTS)
        local_h = file_hash(local_path, normalize=is_text)
        if local_h is None:
            action = 'NOUVEAU'
        elif local_h != info['hash']:
            action = 'MODIFIE'
        else:
            continue
        modified.append((fname, local_h, info['hash'], action, info))

    build = remote_cfg.get('game_build')
    if not isinstance(build, dict):
        build = None
    return {"error": None, "modified": modified, "remote_cfg": remote_cfg,
            "build": build}


def apply_updates(modified, remote_cfg, progress_cb):
    raw_url = normalize_raw_url(remote_cfg.get('raw_url', '') or DEFAULT_RAW_URL)
    errors = []
    downloaded = 0
    pending_launcher = None
    total = len(modified) or 1

    for i, item in enumerate(modified):
        # Compatibilite avec l'ancien tuple a 4 champs.
        fname, _, expected_hash, _ = item[:4]
        info = item[4] if len(item) > 4 and isinstance(item[4], dict) else {}
        pct = int(10 + (i / total) * 8)
        progress_cb(pct, 'Telechargement (%d/%d) : %s' % (i + 1, total, fname))
        try:
            local_path = _safe_local_path(fname)
            os.makedirs(os.path.dirname(local_path), exist_ok=True)
            req = urllib.request.Request(get_remote_url(fname, raw_url, info),
                                         headers={'User-Agent': USER_AGENT})
            with urllib.request.urlopen(req, timeout=180) as resp:
                data = resp.read()

            # Verifier avant de remplacer l'ancien fichier. Une archive
            # corrompue ou interrompue ne peut donc pas casser l'installation.
            is_text = fname.lower().endswith(TEXT_EXTS)
            actual_hash = hashlib.md5(
                data.replace(b'\r\n', b'\n').replace(b'\r', b'\n')
                if is_text else data).hexdigest()
            if actual_hash != expected_hash:
                errors.append('%s : hash ne correspond pas apres telechargement' % fname)
                continue
            expected_size = info.get('size')
            if expected_size is not None and len(data) != int(expected_size):
                errors.append('%s : taille inattendue apres telechargement' % fname)
                continue

            if _is_running_launcher(local_path):
                # Windows verrouille l'executable actuellement lance. On le
                # remplace apres fermeture via un petit script systeme, puis
                # on relance automatiquement le launcher.
                staged = local_path + '.new'
                with open(staged, 'wb') as f:
                    f.write(data)
                pending_launcher = (local_path, staged)
            else:
                _stage_or_replace(local_path, data)
                if (pending_launcher is None
                        and os.path.normcase(os.path.abspath(local_path)) == CORE_PATH):
                    # C'est le code du launcher qui vient de changer : il
                    # suffit de redemarrer pour l'appliquer (le fichier n'est
                    # pas verrouille, l'amorce le relit a chaque lancement).
                    pending_launcher = (None, local_path)
            downloaded += 1
        except Exception as e:
            errors.append('%s : %s' % (fname, e))
    return downloaded, errors, pending_launcher


def _stage_or_replace(path, data):
    """Ecrit un fichier temporaire puis le remplace de maniere atomique."""
    tmp = path + '.download'
    with open(tmp, 'wb') as f:
        f.write(data)
    os.replace(tmp, path)


def schedule_launcher_restart(target, staged):
    """Programme le remplacement de LibreVies.exe apres sa fermeture."""
    script = os.path.join(GAME_DIR, '.librevies-update.cmd')
    try:
        with open(script, 'w', encoding='utf-8', newline='\r\n') as f:
            f.write('@echo off\r\n')
            f.write(':wait\r\n')
            f.write('copy /Y "%s" "%s" >nul 2>&1\r\n' % (staged, target))
            f.write('if errorlevel 1 (timeout /t 1 /nobreak >nul & goto wait)\r\n')
            f.write('del /f /q "%s" >nul 2>&1\r\n' % staged)
            f.write('start "" "%s"\r\n' % target)
            f.write('del /f /q "%~f0" >nul 2>&1\r\n')
        flags = getattr(subprocess, 'CREATE_NO_WINDOW', 0)
        subprocess.Popen(['cmd.exe', '/d', '/c', script], cwd=GAME_DIR,
                         creationflags=flags, close_fds=False)
        return True
    except (OSError, IOError):
        return False


# ============================================================
# JEU COMPLET — TELECHARGEMENT ET INSTALLATION
#
# Le jeu est publie en UNE archive .zip dans la release GitHub.
# Le launcher la telecharge (avec reprise si la connexion coupe),
# verifie son md5, l'extrait dans un dossier temporaire, cherche
# l'executable, puis remplace l'ancienne installation. Une coupure
# a n'importe quel moment laisse donc toujours un jeu utilisable.
# ============================================================

def lire_etat_jeu():
    try:
        with open(ETAT_PATH, 'r', encoding='utf-8') as f:
            etat = json.load(f)
        return etat if isinstance(etat, dict) else {}
    except (OSError, ValueError):
        return {}


def noter_etat_jeu(build, exe):
    etat = {
        'hash': build.get('hash', ''),
        'moteur': build.get('moteur', ''),
        'version': build.get('version', ''),
        'dossier': build.get('dossier', DOSSIER_JEU_DEFAUT),
        'exe': os.path.relpath(exe, GAME_DIR).replace('\\', '/'),
        'installe': time.strftime('%Y-%m-%d %H:%M:%S'),
    }
    tmp = ETAT_PATH + '.tmp'
    with open(tmp, 'w', encoding='utf-8', newline='\n') as f:
        json.dump(etat, f, indent=2, ensure_ascii=False)
        f.write('\n')
    os.replace(tmp, ETAT_PATH)
    return etat


def _dossier_jeu(build=None):
    build = build if isinstance(build, dict) else {}
    nom = build.get('dossier') or lire_etat_jeu().get('dossier') or DOSSIER_JEU_DEFAUT
    return (nom or DOSSIER_JEU_DEFAUT).replace('\\', '/').strip('/')


def _chemin_exe(build, valeur):
    """Resout le champ ``exe`` du manifeste (relatif au jeu ou au dossier)."""
    dossier = _dossier_jeu(build)
    valeur = (valeur or '').replace('\\', '/').lstrip('/')
    if not valeur:
        return None
    if dossier and valeur.lower().startswith(dossier.lower() + '/'):
        return _safe_local_path(valeur)
    return _safe_local_path('%s/%s' % (dossier, valeur))


def _trouver_exe_jeu(dossier, profondeur=2):
    """Cherche l'executable du jeu, sans se fier au nom exact du dossier."""
    try:
        entrees = sorted(os.listdir(dossier))
    except OSError:
        return None
    minuscules = {nom.lower(): nom for nom in NOMS_EXE_JEU}
    for entree in entrees:
        chemin = os.path.join(dossier, entree)
        if os.path.isfile(chemin) and entree.lower() in minuscules:
            return chemin
    if profondeur <= 0:
        return None
    for entree in entrees:
        chemin = os.path.join(dossier, entree)
        if os.path.isdir(chemin):
            trouve = _trouver_exe_jeu(chemin, profondeur - 1)
            if trouve:
                return trouve
    return None


def build_a_installer(build):
    """Le jeu doit-il etre (re)telecharge ? Renvoie (bool, raison lisible)."""
    if not isinstance(build, dict) or not build.get('url') or not build.get('hash'):
        return False, 'aucune compilation Unity publiee pour le moment'
    etat = lire_etat_jeu()
    if etat.get('hash') != build.get('hash'):
        return True, 'nouvelle compilation disponible'
    if not find_game():
        return True, 'fichiers du jeu a reparer'
    return False, 'jeu a jour'


def _taille_distante(url, timeout=15):
    try:
        req = urllib.request.Request(url, method='HEAD',
                                     headers={'User-Agent': USER_AGENT})
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            length = resp.headers.get('Content-Length')
            return int(length) if length else None
    except Exception:
        return None


def _telecharger_archive(url, taille, progress_cb, pct0, pct1):
    """Telecharge l'archive du jeu ; reprend si un fichier partiel existe."""
    partiel = os.path.join(GAME_DIR, NOM_ARCHIVE + '.part')
    total = int(taille) if taille else (_taille_distante(url) or 0)
    debut = os.path.getsize(partiel) if os.path.isfile(partiel) else 0
    if debut and total and debut > total:
        os.remove(partiel)
        debut = 0
    if debut and total and debut == total:
        return partiel

    headers = {'User-Agent': USER_AGENT}
    if debut:
        headers['Range'] = 'bytes=%d-' % debut
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=60) as resp:
        if debut and getattr(resp, 'status', 200) != 206:
            debut = 0                       # le serveur ignore la reprise
        mode = 'ab' if debut else 'wb'
        fait = debut
        dernier = 0.0
        with open(partiel, mode) as f:
            while True:
                bloc = resp.read(262144)
                if not bloc:
                    break
                f.write(bloc)
                fait += len(bloc)
                maintenant = time.time()
                if maintenant - dernier >= 0.4:
                    dernier = maintenant
                    if total:
                        pct = pct0 + int((fait / float(total)) * (pct1 - pct0))
                        progress_cb(min(pct1, pct),
                                    'Telechargement du jeu : %s / %s'
                                    % (_taille_lisible(fait),
                                       _taille_lisible(total)))
                    else:
                        progress_cb(pct0 + 5, 'Telechargement du jeu : %s'
                                    % _taille_lisible(fait))
    return partiel


def _supprimer_dossier(chemin):
    if os.path.isdir(chemin):
        try:
            shutil.rmtree(chemin)
        except OSError:
            time.sleep(0.5)
            shutil.rmtree(chemin, ignore_errors=True)


def _hisser_racine(dossier):
    """Si l'archive contient un unique dossier racine, on le remonte."""
    if _trouver_exe_jeu(dossier):
        return
    try:
        entrees = [e for e in os.listdir(dossier) if not e.startswith('.')]
    except OSError:
        return
    if len(entrees) != 1:
        return
    sous = os.path.join(dossier, entrees[0])
    if not os.path.isdir(sous):
        return
    for enfant in os.listdir(sous):
        os.replace(os.path.join(sous, enfant), os.path.join(dossier, enfant))
    try:
        os.rmdir(sous)
    except OSError:
        pass


def _extraire_zip(archive, dossier, progress_cb, pct0, pct1):
    """Extraction sure (aucun chemin ne peut sortir du dossier du jeu)."""
    racine = os.path.abspath(dossier)
    with zipfile.ZipFile(archive) as z:
        membres = [i for i in z.infolist() if not i.is_dir()]
        total = len(membres) or 1
        for n, info in enumerate(membres):
            nom = info.filename.replace('\\', '/')
            morceaux = [m for m in nom.split('/') if m not in ('', '.')]
            if not morceaux or '..' in morceaux or ':' in morceaux[0]:
                raise ValueError('archive invalide : chemin interdit (%s)' % nom)
            cible = os.path.abspath(os.path.join(racine, *morceaux))
            if os.path.commonpath((racine, cible)) != racine:
                raise ValueError('archive invalide : chemin hors du dossier de jeu')
            os.makedirs(os.path.dirname(cible), exist_ok=True)
            with z.open(info) as source, open(cible, 'wb') as dest:
                shutil.copyfileobj(source, dest, 1024 * 1024)
            if n % 40 == 0 or n == total - 1:
                progress_cb(pct0 + int((n + 1) / float(total) * (pct1 - pct0)),
                            'Installation des fichiers du jeu (%d/%d)...'
                            % (n + 1, total))


def installer_build_jeu(build, progress_cb):
    """Telecharge, verifie et installe la compilation publiee du jeu."""
    url = build.get('url')
    attendu = build.get('hash')
    cible = _safe_local_path(_dossier_jeu(build))
    tmp = _safe_local_path(NOM_DOSSIER_TMP)
    ancien = _safe_local_path(NOM_DOSSIER_ANCIEN)
    dossier_parent = os.path.dirname(cible) or GAME_DIR
    os.makedirs(dossier_parent, exist_ok=True)

    try:
        progress_cb(15, 'Preparation du telechargement du jeu...')
        archive = _telecharger_archive(url, build.get('size'), progress_cb, 18, 72)

        taille_attendue = build.get('size')
        if taille_attendue and os.path.getsize(archive) != int(taille_attendue):
            raise ValueError('l\'archive telechargee est incomplete (%d octets)'
                             % os.path.getsize(archive))
        progress_cb(74, 'Verification de l\'archive du jeu (md5)...')
        if attendu and _md5_fichier(archive) != attendu:
            try:
                os.remove(archive)
            except OSError:
                pass
            raise ValueError('archive du jeu corrompue : reprise au prochain lancement')

        progress_cb(76, 'Installation du jeu...')
        _supprimer_dossier(tmp)
        os.makedirs(tmp, exist_ok=True)
        _extraire_zip(archive, tmp, progress_cb, 78, 94)
        _hisser_racine(tmp)
        exe_tmp = _trouver_exe_jeu(tmp)
        if not exe_tmp:
            _supprimer_dossier(tmp)
            raise ValueError('l\'archive publiee ne contient aucun executable de jeu')
        exe_relatif = os.path.relpath(exe_tmp, tmp)

        progress_cb(96, 'Mise en place du jeu...')
        _supprimer_dossier(ancien)
        remplace = False
        if os.path.isdir(cible):
            os.replace(cible, ancien)
            remplace = True
        try:
            os.replace(tmp, cible)
        except OSError:
            if remplace:                    # on remet l'ancien jeu en place
                os.replace(ancien, cible)
            raise
        _supprimer_dossier(ancien)

        exe = os.path.join(cible, exe_relatif)
        if not os.path.isfile(exe):
            raise ValueError('executable du jeu introuvable apres installation')
        noter_etat_jeu(build, exe)
        try:
            os.remove(archive)              # l'archive ne sert plus a rien
        except OSError:
            pass
        progress_cb(99, 'Jeu installe !')
        return True, 'jeu installe', exe
    except Exception as e:
        return False, str(e), None


def find_game():
    """Retrouve uniquement un jeu valide selon le manifeste distant."""
    etat = lire_etat_jeu()
    cfg = load_local_config()
    build = cfg.get('game_build') if isinstance(cfg.get('game_build'), dict) else {}

    # Ne jamais lancer silencieusement une ancienne compilation presente dans
    # game/. Avant cette verification, un manifeste avec game_build={} laissait
    # le bouton JOUER actif sur un vieux export : l'utilisateur croyait avoir
    # recu la MAJ alors qu'il executait encore l'ancien monde.
    if not build.get('url') or not build.get('hash'):
        return None
    if etat.get('hash') != build.get('hash'):
        return None

    candidats = []
    if etat.get('exe'):
        try:
            candidats.append(_safe_local_path(etat['exe']))
        except ValueError:
            pass
    if build.get('exe'):
        try:
            candidats.append(_chemin_exe(build, build.get('exe')))
        except ValueError:
            pass

    try:
        dossier = _safe_local_path(_dossier_jeu(build))
    except ValueError:
        dossier = None
    for racine in (dossier, os.path.abspath(GAME_DIR)):
        if not racine:
            continue
        for nom in NOMS_EXE_JEU:
            candidats.append(os.path.join(racine, nom))
    if dossier:
        candidats.append(_trouver_exe_jeu(dossier))

    for path in candidats:
        if path and os.path.isfile(path):
            return os.path.abspath(path)
    return None


def dossier_journaux_jeu(exe_path):
    """Dossier des journaux du jeu (a cote de son executable)."""
    try:
        dossier = os.path.join(os.path.dirname(os.path.abspath(exe_path)), 'logs')
        os.makedirs(dossier, exist_ok=True)
        return dossier
    except (OSError, TypeError):
        return None


def launch(path):
    # La build du jeu contient deja son runtime : aucun telechargement et
    # aucun runtime a installer. -logFile sert uniquement a retrouver le
    # journal du jeu (et donc la cause d'un plantage) sans chercher partout.
    args = [path]
    journaux = dossier_journaux_jeu(path)
    if journaux:
        args += ['-logFile', os.path.join(journaux, 'LibreVies.log')]
    subprocess.Popen(args, cwd=os.path.dirname(path), close_fds=False)
