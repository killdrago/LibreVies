BANNER_B64 = ""
ICON_B64 = ""
ICO_B64 = ""

_EMBED_CACHE = {}


def _embedded_photo(b64, size=None):
    """Renvoie une image Tk (PhotoImage) depuis les bytes integrees.
    Avec Pillow : decode en memoire. Sans Pillow : fichier PNG temporaire."""
    key = (len(b64), size)
    if key in _EMBED_CACHE:
        return _EMBED_CACHE[key]
    img = None
    try:
        data = base64.b64decode(b64)
    except Exception:
        return None
    try:
        from PIL import Image, ImageTk
        im = Image.open(io.BytesIO(data))
        if size:
            im = im.resize(size, Image.LANCZOS)
        img = ImageTk.PhotoImage(im)
    except Exception:
        try:
            fd, path = tempfile.mkstemp(suffix=".png")
            os.write(fd, data)
            os.close(fd)
            img = tk.PhotoImage(file=path)
        except Exception:
            img = None
    _EMBED_CACHE[key] = img
    return img


def export_icon(path="icon.ico"):
    """Recrete icon.ico (pour build_launcher.bat) depuis les bytes integres."""
    with open(path, "wb") as f:
        f.write(base64.b64decode(ICO_B64))
    return path


def export_banner(path="banniere_v1.png"):
    """Optionnel : recrete la banniere 1024x768 sur disque."""
    with open(path, "wb") as f:
        f.write(base64.b64decode(BANNER_B64))
    return path


