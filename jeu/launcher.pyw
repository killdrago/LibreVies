TEXT_EXTS = ('.pyw', '.py', '.bat', '.json', '.cfg', '.txt', '.md',
             '.html', '.css', '.js', '.csv', '.cs', '.meta', '.unity')

USER_AGENT = 'LibreVies/%s' % LAUNCHER_VERSION


def file_hash(path, normalize=False):
    """Retourne le MD5 d'un fichier sans faire echouer le launcher."""
    try:
        with open(path, 'rb') as f:
            data = f.read()
        if normalize:
            data = data.replace(b'\r\n', b'\n').replace(b'\r', b'\n')
        return hashlib.md5(data).hexdigest()
    except (OSError, IOError):
        return None


def _md5_fichier(path):
    """MD5 d'un gros fichier, calcule par blocs (memoire constante)."""
    h = hashlib.md5()
    with open(path, 'rb') as f:
        for bloc in iter(lambda: f.read(1024 * 1024), b''):
            h.update(bloc)
    return h.hexdigest()


def load_local_config():
    if os.path.exists(CONFIG_PATH):
        try:
            with open(CONFIG_PATH, 'r', encoding='utf-8') as f:
                return json.load(f)
        except (OSError, ValueError):
            pass
    return {"launcher_version": LAUNCHER_VERSION, "game_version": GAME_VERSION,
            "notes": "", "game_url": "", "raw_url": DEFAULT_RAW_URL,
            "files": {}, "game_build": {}}


def save_local_config(cfg):
    # Les identifiants facultatifs appartiennent a la machine, pas au
    # manifeste distant : ne jamais les perdre lorsqu'une MAJ est enregistree.
    try:
        with open(CONFIG_PATH, 'r', encoding='utf-8') as f:
            previous = json.load(f)
        if isinstance(previous, dict):
            cfg = dict(cfg)
            for key in ('saved_pseudo', 'saved_mdp'):
                if key not in cfg and key in previous:
                    cfg[key] = previous[key]
    except (OSError, ValueError):
        pass

    # Ecriture atomique : une coupure pendant la mise a jour ne doit jamais
    # laisser un version_url.json vide ou invalide.
    tmp = CONFIG_PATH + '.tmp'
    with open(tmp, 'w', encoding='utf-8', newline='\n') as f:
        json.dump(cfg, f, indent=2, ensure_ascii=False)
        f.write('\n')
    os.replace(tmp, CONFIG_PATH)


def normalize_raw_url(url):
    """Convertit une URL GitHub/tree en URL raw utilisable."""
    url = (url or '').strip().rstrip('/')
    if not url:
        return url
    if 'raw.githubusercontent.com' in url:
        return url.replace('/tree/', '/')
    if 'github.com' in url:
        parts = url.split('github.com/', 1)[1]
        seg = [item for item in parts.split('/') if item]
        if len(seg) >= 4 and seg[2] == 'tree':
            return "https://raw.githubusercontent.com/%s/%s/%s" % (
                seg[0], seg[1], '/'.join(seg[3:]))
        if len(seg) >= 2:
            return "https://raw.githubusercontent.com/%s/%s/HEAD" % (seg[0], seg[1])
    return url


def get_remote_url(fname, raw_url, info=None):
    """Utilise une URL d'asset quand le manifeste en fournit une.

    L'archive du jeu et le launcher compile sont publies dans une release
    GitHub plutot que dans git : le champ ``url`` permet de les telecharger
    sans imposer un serveur ni une installation au joueur.
    """
    if isinstance(info, dict) and info.get('url'):
        return info['url']
    return "%s/%s" % (raw_url, urllib.request.quote(fname))


def _safe_local_path(fname):
    """Resout un chemin du manifeste en restant dans le dossier du jeu.

    Un chemin absolu, un lecteur Windows ou un ``..`` est refuse : le
    manifeste ne peut jamais ecrire en dehors du dossier du launcher.
    """
    brut = (fname or '').replace('\\', '/')
    relative = brut.strip('/')
    if (not relative or brut.startswith('/') or ':' in relative.split('/')[0]
            or '..' in relative.split('/')):
        raise ValueError('chemin de mise a jour invalide')
    root = os.path.abspath(GAME_DIR)
    path = os.path.abspath(os.path.join(root, *relative.split('/')))
    if os.path.commonpath((root, path)) != root:
        raise ValueError('chemin de mise a jour invalide')
    return path


def _manifest_files(cfg):
    """Fichiers unitaires a mettre a jour (petits fichiers texte).

    Le jeu lui-meme n'est pas dans cette liste : il arrive en une seule
    archive (cle ``game_build``). Seul le launcher compile s'y ajoute.
    """
    files = cfg.get('files')
    if not isinstance(files, dict):
        return {}
    resultat = {}
    for nom, info in files.items():
        if not isinstance(info, dict) or not info.get('hash'):
            continue
        if nom == 'launcher.pyw' and not getattr(sys, 'frozen', False):
            # Le launcher en cours de developpement se met a jour avec git.
            continue
        if nom.lower() == 'librevies.exe' and not getattr(sys, 'frozen', False):
            # Inutile de telecharger l'exe quand on travaille sur les sources.
            continue
        resultat[nom] = info
    return resultat


def _is_running_launcher(path):
    if not getattr(sys, 'frozen', False):
        return False
    try:
        return os.path.normcase(os.path.abspath(path)) == os.path.normcase(
            os.path.abspath(sys.executable))
    except (OSError, TypeError):
        return False


def _lire_json(url, timeout=20):
    req = urllib.request.Request(url, headers={'User-Agent': USER_AGENT})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode('utf-8'))


def _taille_lisible(octets):
    """312 Ko, 39,3 Mo : lisible dans la barre de progression."""
    octets = float(octets or 0)
    if octets >= 1048576:
        return '%.1f Mo' % (octets / 1048576.0)
    if octets >= 1024:
        return '%.0f Ko' % (octets / 1024.0)
    return '%d octets' % int(octets)


